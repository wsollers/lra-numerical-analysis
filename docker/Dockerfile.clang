FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    ca-certificates \
    clang-18 \
    cmake \
    git \
    lld-18 \
    ninja-build \
    python3 \
    python3-pip \
    python3-venv \
    libvulkan-dev \
    vulkan-validationlayers \
    vulkan-utility-libraries-dev \
    glslang-tools \
    libxinerama-dev \
    libxcursor-dev \
    libxi-dev \
    libxrandr-dev \
    libwayland-dev \
    wayland-protocols \
    libxkbcommon-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/lra-analysis \
    && /opt/lra-analysis/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/lra-analysis/bin/pip install --no-cache-dir \
        matplotlib \
        numpy \
        pandas \
        scipy \
        seaborn

ENV PATH="/opt/lra-analysis/bin:${PATH}"
ENV CC=clang-18
ENV CXX=clang++-18

WORKDIR /workspace
